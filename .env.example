# Copy to `.env` and fill in your own project's values.
#
# Both are safe to expose to the browser. The publishable key is scoped to the
# `anon` role, and row level security decides what that role may read or write.
# Never put a service_role or secret key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
