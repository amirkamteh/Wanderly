# Production environment — committed deliberately.
#
# The Docker image builds from a git clone, so these must be in the repo for
# `next build` to inline them into the client bundle.
#
# Both values are public by design: any NEXT_PUBLIC_ variable is sent to the
# browser, so anyone can read them from the JS bundle of a deployed site. The
# publishable key is scoped to the `anon` role and row level security is what
# actually restricts access — anon may only read the catalogue and insert a
# booking request.
#
# NEVER put a service_role key, database password or any other secret in this
# file. Secrets belong in GitHub Actions secrets or an untracked .env on the
# server.
NEXT_PUBLIC_SUPABASE_URL=https://suqxiowruttxbumsttej.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_0hKO_v1QcsEf7AKxTTl71w_NhPlfakm
